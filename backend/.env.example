# Copia este archivo como backend/.env y llena los valores.
# El archivo .env nunca se sube al repositorio: aquí solo van los nombres.

# Servidor
PORT=3000
NODE_ENV=development
# Dirección de la aplicación web (frontend/, npm run dev). Varias, separadas por comas.
# En desarrollo, Vite pasa las peticiones a la API, así que esto solo importa si la web corre en otro servidor.
CORS_ORIGIN=http://localhost:5173
# Enlace que reciben los clientes en los correos de aviso.
PORTAL_URL=http://localhost:5173/

# Base de datos MySQL. Con Docker (docker compose up -d) se crea con estos mismos datos:
# elige un usuario (que no sea root) y una contraseña larga.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=portal_proyectos

# Sesiones: una frase larga y aleatoria, distinta en cada computadora.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Correo para avisos al cliente (opcional: si queda vacío, no se envían correos).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Carpeta para fotos y documentos (opcional: por defecto, backend/uploads).
UPLOADS_DIR=

# Solo para una base en la nube o el despliegue en Vercel (docs/DESPLIEGUE.md).
# Con Docker en local se dejan vacías.
# DB_SSL=true cifra la conexión; DB_SSL_CA es el certificado público del proveedor.
DB_SSL=
DB_SSL_CA=
# Hora del centro de México para NOW(): -06:00. Docker ya la trae.
DB_TIMEZONE=
# Vercel Blob: Vercel la pone sola al conectar el almacén. Si está, los archivos van ahí.
BLOB_READ_WRITE_TOKEN=
